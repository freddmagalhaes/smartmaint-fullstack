# Usa o Node 20 para o backend
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

# Copia apenas os arquivos de dependência do backend
COPY server/package*.json ./

# Instala somente as dependências de produção
RUN npm ci --omit=dev

# Copia o resto do código da pasta server
COPY server/ .

# Pasta usada pelo multer para salvar os uploads
RUN mkdir -p uploads

# Porta usada pelo backend (server/index.js -> PORT, padrão 3001)
ENV PORT=3001
EXPOSE 3001

# Inicia o servidor Node.js
CMD ["npm", "start"]
