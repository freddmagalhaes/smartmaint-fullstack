# SmartMaint — somente a API (para quem hospeda o frontend separado, ex.: S3 + CloudFront).
# Para o deploy padrão (frontend + API no mesmo container) use o Dockerfile principal.
FROM node:22-alpine
ENV NODE_ENV=production \
    PORT=3001 \
    UPLOAD_DIR=/app/uploads
WORKDIR /app/server

COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev
COPY server ./

RUN mkdir -p /app/uploads && chown -R node:node /app/uploads
USER node

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/api/health" || exit 1

CMD ["node", "index.js"]
