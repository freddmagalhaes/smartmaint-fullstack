# Copie para .env e ajuste os valores: cp .env.example .env
# Usado pelo docker-compose.yml

# Banco de dados. Use senhas fortes e diferentes entre si (openssl rand -hex 16)
# DB_ROOT_PASSWORD: administração do MySQL; DB_USER/DB_PASSWORD: usuário usado pela API
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_USER=smartmaint
DB_PASSWORD=troque-esta-senha
DB_NAME=smartmaint_db

# OBRIGATÓRIO: chave forte para assinar os tokens JWT
# Gere uma com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave

# Portas expostas no host (Windows/WSL)
WEB_PORT=8080
DB_EXTERNAL_PORT=3307

# URL pública do frontend (links de e-mail e Stripe)
FRONTEND_URL=http://localhost:8080

# Opcionais
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Origens extras permitidas no CORS (separadas por vírgula). Por padrão vale só FRONTEND_URL
CORS_ORIGINS=

# Pagamentos (Stripe). Em produção a chave é obrigatória para cobrar faturas.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...). Cadastre no Stripe a URL: <FRONTEND_URL>/api/webhooks/stripe
# com os eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Cadastro autoatendido com período de teste
# SIGNUP_ENABLED=false desliga o endpoint /api/signup (e, no build do front, VITE_SIGNUP_ENABLED=false esconde o link)
SIGNUP_ENABLED=true
TRIAL_DAYS=14
# Links exibidos no checkbox de aceite do cadastro (variáveis de BUILD do front; opcionais)
# VITE_TERMS_URL=https://seusite.com/termos
# VITE_PRIVACY_URL=https://seusite.com/privacidade
