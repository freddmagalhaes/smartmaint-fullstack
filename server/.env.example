# Copie para server/.env (desenvolvimento) ou configure como variáveis de ambiente no servidor.
# Nunca faça commit do arquivo .env.

# --- Obrigatórias ---
NODE_ENV=development
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartmaint_db
# Endereço público do sistema (links de e-mail e retorno do pagamento)
FRONTEND_URL=http://localhost:5173

# --- Servidor ---
PORT=3001
# Proxies à frente da aplicação (ALB/CloudFront). Padrão: 1 em produção, 0 em desenvolvimento
# TRUST_PROXY=1
# Origens liberadas no CORS (só se o frontend estiver em outro domínio), separadas por vírgula
# CORS_ORIGIN=https://app.suaempresa.com.br
# Duração da sessão
# JWT_EXPIRES_IN=12h
# Defina true quando o site for servido apenas por HTTPS
# FORCE_HTTPS=true
# Banco com TLS: "rds" para Amazon RDS, "true" para outros provedores
# DB_SSL=rds
# Desative se as migrations rodarem em um passo separado do deploy
# RUN_MIGRATIONS=true

# --- E-mail (convites e recuperação de senha) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@suaempresa.com.br

# --- Pagamentos (Stripe) ---
STRIPE_SECRET_KEY=
# Assinatura do endpoint POST /api/billing/webhook (eventos: veja "Assinatura e cobrança" no README)
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=card,boleto
# Assinatura com Pix Automático (só ligue após o Stripe confirmar que a conta tem o recurso)
STRIPE_PIX_AUTOMATICO=false
# Bloqueio automático de clientes com fatura atrasada há mais de N dias
BILLING_AUTO_BLOCK=true
BILLING_GRACE_DAYS=10
# Boleto/Pix: dias de antecedência para gerar a fatura do mês e prazo da primeira fatura
BILLING_INVOICE_LEAD_DAYS=10
BILLING_FIRST_INVOICE_DUE_DAYS=3

# --- Monitoramento ---
# Nível dos logs em JSON (debug, info, warn, error)
LOG_LEVEL=info
# Sentry do backend (opcional). O do frontend é VITE_SENTRY_DSN, definido no build da imagem.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- NFS-e padrão nacional (Emissor Nacional / Sefin Nacional) ---
# Mantenha false até ter CNPJ, inscrição municipal e certificado A1. Os dados fiscais
# do prestador são preenchidos no Backoffice > Fiscal (NFS-e).
NFSE_ENABLED=false
# homologacao (produção restrita, para testes) ou producao
NFSE_AMBIENTE=homologacao
# Certificado A1 (.pfx) em base64: base64 -w0 certificado.pfx  (ou caminho em NFSE_CERT_PATH)
# NFSE_CERT_BASE64=
# NFSE_CERT_PATH=
# NFSE_CERT_PASSWORD=
# URL da API, se precisar sobrescrever a padrão do ambiente
# NFSE_API_URL=

# --- Arquivos enviados ---
# Recomendado em produção: o disco do container é perdido a cada deploy
# S3_BUCKET=
# S3_REGION=sa-east-1
# UPLOAD_DIR=./uploads

# --- Seed (npm run seed) ---
# MASTER_EMAIL=
# MASTER_PASSWORD=
