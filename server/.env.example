# Copie para server/.env (desenvolvimento) ou configure como variáveis de ambiente no servidor.
# Nunca faça commit do arquivo .env.

# --- Obrigatórias ---
NODE_ENV=development
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartmaint_db
# Endereço público do sistema (links de e-mail e retorno do pagamento)
FRONTEND_URL=http://localhost:5173

# --- Servidor ---
PORT=3001
# Proxies à frente da aplicação (ALB/CloudFront). Padrão: 1 em produção, 0 em desenvolvimento
# TRUST_PROXY=1
# Origens liberadas no CORS (só se o frontend estiver em outro domínio), separadas por vírgula
# CORS_ORIGIN=https://app.suaempresa.com.br
# Duração da sessão
# JWT_EXPIRES_IN=12h
# Defina true quando o site for servido apenas por HTTPS
# FORCE_HTTPS=true
# Banco com TLS: "rds" para Amazon RDS, "true" para outros provedores
# DB_SSL=rds
# Desative se as migrations rodarem em um passo separado do deploy
# RUN_MIGRATIONS=true

# --- E-mail (convites e recuperação de senha) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@suaempresa.com.br

# --- Pagamentos (Stripe) ---
STRIPE_SECRET_KEY=
# Assinatura do endpoint POST /api/billing/webhook (eventos checkout.session.completed e
# checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=card,boleto
# Bloqueio automático de clientes com fatura atrasada há mais de N dias
BILLING_AUTO_BLOCK=true
BILLING_GRACE_DAYS=10

# --- Arquivos enviados ---
# Recomendado em produção: o disco do container é perdido a cada deploy
# S3_BUCKET=
# S3_REGION=sa-east-1
# UPLOAD_DIR=./uploads

# --- Seed (npm run seed) ---
# MASTER_EMAIL=
# MASTER_PASSWORD=
